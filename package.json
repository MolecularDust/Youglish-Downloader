{
  "name": "youglish-downloader",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint src",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "package": "node scripts/package-macos.mjs",
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "format": "prettier --write src scripts docs README.md",
    "package:dev": "npm run prepare:sidecars && node scripts/desktop.mjs build --debug --bundles app --config src-tauri/tauri.dev-bundle.conf.json && node scripts/embed-yt-dlp.mjs \"src-tauri/target/debug/bundle/macos/YouGlish Downloader.app\" --reseal",
    "package:portable": "node scripts/package-windows-portable.mjs",
    "package:windows-installer": "node scripts/package-windows-installer.mjs",
    "package:windows": "npm run prepare:sidecars && node scripts/desktop.mjs build --bundles nsis --config src-tauri/tauri.windows.conf.json",
    "package:installer": "bash tools/installer/make_installer.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8",
    "react": "^19.1",
    "react-dom": "^19.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0",
    "@tauri-apps/cli": "^2.8",
    "@types/react": "^19.1",
    "@types/react-dom": "^19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9",
    "typescript-eslint": "^8.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
